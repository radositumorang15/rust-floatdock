{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Float Dock",
  "version": "0.1.0",
  "identifier": "com.floatdock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dock",
        "title": "Float Dock",
        "url": "index.html#dock",
        "width": 1680,
        "height": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "start_menu",
        "title": "Start Menu",
        "url": "index.html#start_menu",
        "width": 390,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "notch",
        "title": "Notch",
        "url": "index.html#notch",
        "width": 120,
        "height": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "Float Dock Settings",
        "url": "index.html#settings",
        "width": 640,
        "height": 540,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
